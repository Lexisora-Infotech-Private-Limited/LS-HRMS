{
  "name": "@lexisora/tracker",
  "version": "1.4.2",
  "private": true,
  "description": "Lexisora Tracker — Windows desktop time tracker",
  "author": "Lexisora Infotech",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@lexisora/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.0.0",
    "zod": "3.25.76"
  }
}
