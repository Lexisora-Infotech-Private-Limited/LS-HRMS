// ── People domain: vault, onboarding + e-sign, lifecycle, recruitment, appraisals,
//    assets, welcome kits, ID cards, visiting cards. References to core models (Employee,
//    User, Department, Designation, Branch, FileObject) are plain scalar ids.

// ── Digital vault ───────────────────────────────────────────────────────────

enum PeopleDocCategory {
  OFFER_COMPENSATION
  GOVERNMENT_ID
  EDUCATION
  EMPLOYMENT
  LEGAL
  BANK_TAX
  CAREER
  EXIT
  CERTIFICATE
  OTHER
}

enum PeopleDocType {
  OFFER_LETTER
  NDA
  COMPENSATION_BREAKDOWN
  PAN
  AADHAAR
  PASSPORT
  MARKSHEET_10
  MARKSHEET_12
  DEGREE
  PREV_EMPLOYMENT
  RELIEVING_LETTER
  EXPERIENCE_LETTER
  CANCELLED_CHEQUE
  RESUME
  POLICY_ACK
  CERTIFICATE
  OTHER
}

enum PeopleDocVerification {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
}

enum PeopleDocSource {
  SELF_UPLOAD
  HR_UPLOAD
  GENERATED
  ESIGNED
  RECRUITMENT
}

model EmployeeDocument {
  id                 String                @id @default(cuid())
  tenantId           String
  employeeId         String
  category           PeopleDocCategory
  docType            PeopleDocType
  title              String
  fileId             String
  version            Int                   @default(1)
  isCurrent          Boolean               @default(true)
  supersedesId       String?
  source             PeopleDocSource
  verificationStatus PeopleDocVerification @default(PENDING)
  verifiedByUserId   String?
  verifiedByName     String?
  verifiedAt         DateTime?
  rejectionReason    String?
  esignEnvelopeId    String?
  tags               String[]
  uploadedAt         DateTime              @default(now())
  uploadedByUserId   String?
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([tenantId, employeeId, category])
  @@index([tenantId, verificationStatus])
  @@index([tenantId, fileId])
}

// ── Paperless onboarding ────────────────────────────────────────────────────

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum OnboardingStepStatus {
  PENDING
  IN_PROGRESS
  DONE
  NEEDS_ATTENTION
  SKIPPED
}

model Onboarding {
  id              String           @id @default(cuid())
  tenantId        String
  employeeId      String           @unique
  status          OnboardingStatus @default(NOT_STARTED)
  invitedAt       DateTime?
  startedAt       DateTime?
  submittedAt     DateTime?
  completedAt     DateTime?
  bankVerifiedAt  DateTime?
  bankVerifiedBy  String?
  overrideReason  String?
  declinedReason  String?
  steps           OnboardingStep[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, status])
}

model OnboardingStep {
  id              String               @id @default(cuid())
  tenantId        String
  onboardingId    String
  onboarding      Onboarding           @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  key             String // offer | nda | docs | bank | kit
  order           Int
  status          OnboardingStepStatus @default(PENDING)
  data            Json?
  note            String?
  esignEnvelopeId String?
  completedAt     DateTime?
  updatedAt       DateTime             @updatedAt

  @@unique([onboardingId, key])
  @@index([tenantId])
}

// ── E-sign (local provider) ─────────────────────────────────────────────────

enum EsignStatus {
  CREATED
  SENT
  VIEWED
  COMPLETED
  DECLINED
  EXPIRED
  VOIDED
}

model EsignEnvelope {
  id                String       @id @default(cuid())
  tenantId          String
  provider          String       @default("local")
  title             String
  purpose           String // OFFER | NDA | ADHOC
  subjectEmployeeId String?
  /// Data used to render the document (re-rendered with the signature stamped on completion).
  docData           Json
  originalFileId    String
  originalSha256    String
  signedFileId      String?
  signedSha256      String?
  status            EsignStatus  @default(SENT)
  expiresAt         DateTime
  signerName        String
  signerEmail       String
  signerUserId      String?
  signatureType     String? // DRAWN | TYPED
  typedName         String?
  typedFont         String?
  signatureFileId   String?
  consentText       String?
  signedAt          DateTime?
  signerIp          String?
  signerUserAgent   String?
  declineReason     String?
  events            EsignEvent[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tenantId, subjectEmployeeId])
  @@index([signedSha256])
}

model EsignEvent {
  id          String        @id @default(cuid())
  tenantId    String
  envelopeId  String
  envelope    EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  type        String // CREATED SENT VIEWED CONSENTED SIGNED DECLINED COMPLETED VOIDED DOWNLOADED
  actorUserId String?
  actorEmail  String?
  ip          String?
  userAgent   String?
  meta        Json?
  at          DateTime      @default(now())

  @@index([tenantId, envelopeId, at])
}

// ── Lifecycle: exit, import ─────────────────────────────────────────────────

enum ExitType {
  RESIGNATION
  TERMINATION
  END_OF_INTERNSHIP
  ABSCONDING
  RETIREMENT
}

enum ExitCaseStatus {
  OPEN
  WITHDRAWN
  COMPLETED
}

model ExitCase {
  id                  String              @id @default(cuid())
  tenantId            String
  employeeId          String
  exitType            ExitType
  resignationDate     DateTime            @db.Date
  lastWorkingDay      DateTime            @db.Date
  noticeShortfallDays Int                 @default(0)
  reason              String?
  status              ExitCaseStatus      @default(OPEN)
  completedAt         DateTime?
  items               ExitChecklistItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model ExitChecklistItem {
  id           String    @id @default(cuid())
  tenantId     String
  exitCaseId   String
  exitCase     ExitCase  @relation(fields: [exitCaseId], references: [id], onDelete: Cascade)
  key          String // ASSET_RETURN IDCARD_SURRENDER KT_HANDOVER ACCESS_REVOKE FNF_SETTLEMENT RELIEVING_LETTER EXIT_INTERVIEW
  label        String
  ownerRole    String
  blocking     Boolean   @default(false)
  auto         Boolean   @default(false)
  status       String    @default("PENDING") // PENDING | DONE | NA
  doneByName   String?
  doneAt       DateTime?
  note         String?
  order        Int       @default(0)

  @@unique([exitCaseId, key])
  @@index([tenantId])
}

model EmployeeImport {
  id              String   @id @default(cuid())
  tenantId        String
  filename        String
  status          String   @default("VALIDATED") // VALIDATED | DONE | FAILED
  options         Json
  totalRows       Int
  validRows       Int
  importedRows    Int      @default(0)
  /// Parsed + normalised rows (valid ones) ready to commit.
  rows            Json
  rowErrors       Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  committedAt     DateTime?

  @@index([tenantId, createdAt])
}

/// Dedupe keys for scheduled alerts (warranty thresholds, reminders).
model PeopleAlertLog {
  id       String   @id @default(cuid())
  tenantId String
  key      String
  sentAt   DateTime @default(now())

  @@unique([tenantId, key])
}

// ── Recruitment ─────────────────────────────────────────────────────────────

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
  PART_TIME
}

model Job {
  id               String           @id @default(cuid())
  tenantId         String
  code             String
  title            String
  departmentId     String
  designationId    String?
  jobType          JobType          @default(FULL_TIME)
  openings         Int              @default(1)
  branchId         String?
  description      String?
  experienceMinYrs Int?
  experienceMaxYrs Int?
  hiringManagerId  String?
  roundNames       String[]
  status           JobStatus        @default(OPEN)
  publishedAt      DateTime?
  closedAt         DateTime?
  closeReason      String?
  applications     JobApplication[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status, departmentId])
}

enum CandidateSource {
  LINKEDIN
  REFERRAL
  NAUKRI
  CAMPUS
  CAREERS_PAGE
  AGENCY
  WALK_IN
  OTHER
}

model Candidate {
  id                   String           @id @default(cuid())
  tenantId             String
  fullName             String
  email                String
  phone                String
  location             String?
  currentCompany       String?
  currentCtcPaise      Int?
  expectedCtcPaise     Int?
  noticePeriodDays     Int?
  totalExpMonths       Int?
  source               CandidateSource
  referredByEmployeeId String?
  tags                 String[]
  resumeFileId         String?
  consentAt            DateTime?
  retentionUntil       DateTime         @db.Date
  anonymisedAt         DateTime?
  notes                String?
  applications         JobApplication[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, phone])
}

enum ApplicationStage {
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  OFFER_DECLINED
  WITHDRAWN
}

model JobApplication {
  id             String                @id @default(cuid())
  tenantId       String
  candidateId    String
  candidate      Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job                   @relation(fields: [jobId], references: [id])
  stage          ApplicationStage      @default(SCREENING)
  stageChangedAt DateTime              @default(now())
  score          Float?
  rejectReason   String?
  employeeId     String?
  interviews     Interview[]
  offer          JobOffer?
  events         JobApplicationEvent[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([candidateId, jobId])
  @@index([tenantId, stage])
  @@index([tenantId, jobId, stage])
}

model JobApplicationEvent {
  id            String            @id @default(cuid())
  tenantId      String
  applicationId String
  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStage?
  to            ApplicationStage
  byName        String?
  reason        String?
  at            DateTime          @default(now())

  @@index([tenantId, applicationId])
}

model InterviewRound {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  order              Int      @default(0)
  defaultDurationMin Int      @default(60)
  criteria           Json
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@unique([tenantId, name])
}

enum InterviewMode {
  VIDEO
  IN_OFFICE
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewResult {
  PENDING
  SELECTED
  REJECTED
  ON_HOLD
}

model Interview {
  id               String               @id @default(cuid())
  tenantId         String
  applicationId    String
  application      JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundName        String
  sequence         Int                  @default(1)
  startsAt         DateTime
  durationMin      Int                  @default(60)
  mode             InterviewMode        @default(VIDEO)
  location         String?
  notesToCandidate String?
  status           InterviewStatus      @default(SCHEDULED)
  result           InterviewResult      @default(PENDING)
  icsUid           String
  icsSequence      Int                  @default(0)
  emailedAt        DateTime?
  panelists        InterviewPanelist[]
  scorecards       InterviewScorecard[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId, startsAt])
}

model InterviewPanelist {
  id          String    @id @default(cuid())
  tenantId    String
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId  String
  role        String    @default("LEAD") // LEAD | PANELIST

  @@unique([interviewId, employeeId])
  @@index([tenantId, employeeId])
}

model InterviewScorecard {
  id                    String    @id @default(cuid())
  tenantId              String
  interviewId           String
  interview             Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerEmployeeId String
  ratings               Json // [{key,label,rating 1-5,comment}]
  overall               Float?
  recommendation        String? // STRONG_HIRE HIRE NO_HIRE STRONG_NO_HIRE
  notes                 String?
  status                String    @default("DRAFT") // DRAFT | SUBMITTED
  submittedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@unique([interviewId, interviewerEmployeeId])
  @@index([tenantId])
}

enum JobOfferStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model JobOffer {
  id             String         @id @default(cuid())
  tenantId       String
  applicationId  String         @unique
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  designationId  String?
  departmentId   String?
  branchId       String?
  employmentType String         @default("FULL_TIME")
  annualCtcPaise Int
  joiningDate    DateTime       @db.Date
  expiresOn      DateTime       @db.Date
  status         JobOfferStatus @default(DRAFT)
  employeeId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
}

// ── Appraisals ──────────────────────────────────────────────────────────────

model KraTemplate {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  version      Int       @default(1)
  status       String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  ratingLabels Json
  items        KraItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, name, version])
}

model KraItem {
  id          String      @id @default(cuid())
  tenantId    String
  templateId  String
  template    KraTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  measurement String?
  weight      Float
  order       Int         @default(0)

  @@index([tenantId, templateId])
}

enum AppraisalCycleStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  CALIBRATION
  CLOSED
}

model AppraisalCycle {
  id               String                 @id @default(cuid())
  tenantId         String
  name             String
  periodFrom       DateTime               @db.Date
  periodTo         DateTime               @db.Date
  templateId       String
  selfReviewDue    DateTime               @db.Date
  managerReviewDue DateTime               @db.Date
  eligibility      Json // { minTenureDays, types[] }
  status           AppraisalCycleStatus   @default(DRAFT)
  launchedAt       DateTime?
  closedAt         DateTime?
  participants     AppraisalParticipant[]
  createdAt        DateTime               @default(now())

  @@unique([tenantId, name])
}

enum AppraisalReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

model AppraisalParticipant {
  id                 String                @id @default(cuid())
  tenantId           String
  cycleId            String
  cycle              AppraisalCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId         String
  reviewerEmployeeId String
  templateId         String
  /// Frozen KRA list at launch: [{id,title,description,measurement,weight}]
  templateSnapshot   Json
  /// { [kraId]: { selfRating, selfComment, managerRating, managerComment } }
  ratings            Json                  @default("{}")
  selfStatus         AppraisalReviewStatus @default(NOT_STARTED)
  managerStatus      AppraisalReviewStatus @default(NOT_STARTED)
  selfSubmittedAt    DateTime?
  managerSubmittedAt DateTime?
  selfScore          Float?
  managerScore       Float?
  calibratedScore    Float?
  finalScore         Float?
  band               String?
  calibrationNote    String?
  acknowledgedAt     DateTime?
  employeeComment    String?
  withdrawn          Boolean               @default(false)

  @@unique([cycleId, employeeId])
  @@index([tenantId, reviewerEmployeeId])
  @@index([tenantId, employeeId])
}

// ── Assets ──────────────────────────────────────────────────────────────────

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  UNDER_REPAIR
  RETURNED
  RETIRED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

model AssetCategory {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  requiresSerial Boolean  @default(true)
  assets         Asset[]
  createdAt      DateTime @default(now())

  @@unique([tenantId, name])
}

model Asset {
  id                  String            @id @default(cuid())
  tenantId            String
  assetTag            String
  name                String
  categoryId          String?
  category            AssetCategory?    @relation(fields: [categoryId], references: [id])
  make                String?
  model               String?
  serialNo            String?
  purchaseDate        DateTime?         @db.Date
  purchaseCostPaise   Int?
  vendor              String?
  warrantyTill        DateTime?         @db.Date
  status              AssetStatus       @default(IN_STOCK)
  condition           AssetCondition    @default(NEW)
  branchId            String?
  currentAssigneeId   String?
  currentAssignmentId String?
  statusBeforeRepair  AssetStatus?
  notes               String?
  deletedAt           DateTime?
  assignments         AssetAssignment[]
  repairs             AssetRepair[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNo])
  @@index([tenantId, status])
  @@index([tenantId, warrantyTill])
  @@index([tenantId, currentAssigneeId])
}

model AssetAssignment {
  id              String          @id @default(cuid())
  tenantId        String
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId      String
  assignedOn      DateTime        @db.Date
  assignedByName  String?
  acknowledgedAt  DateTime?
  returnedOn      DateTime?       @db.Date
  returnCondition AssetCondition?
  returnNotes     String?
  createdAt       DateTime        @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, assetId])
}

model AssetRepair {
  id           String    @id @default(cuid())
  tenantId     String
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor       String?
  issue        String
  sentOn       DateTime  @db.Date
  expectedBack DateTime? @db.Date
  costPaise    Int?
  completedOn  DateTime? @db.Date
  createdAt    DateTime  @default(now())

  @@index([tenantId, assetId])
}

// ── Welcome kits ────────────────────────────────────────────────────────────

model WelcomeKitItem {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  sizes             String[]
  /// {"M":20} for sized items, {"_":40} otherwise
  stock             Json
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([tenantId, name])
}

enum KitStatus {
  PENDING
  PARTIAL
  ISSUED
  VOID
}

model WelcomeKitIssue {
  id             String                @id @default(cuid())
  tenantId       String
  employeeId     String                @unique
  status         KitStatus             @default(PENDING)
  tshirtSize     String?
  delivery       String                @default("HANDOVER") // HANDOVER | SHIPPED
  trackingNo     String?
  lastIssuedName String?
  completedAt    DateTime?
  lines          WelcomeKitIssueLine[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId, status])
}

model WelcomeKitIssueLine {
  id           String          @id @default(cuid())
  tenantId     String
  issueId      String
  issue        WelcomeKitIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId       String
  size         String?
  issued       Boolean         @default(false)
  issuedOn     DateTime?       @db.Date
  issuedByName String?

  @@unique([issueId, itemId])
  @@index([tenantId])
}

// ── ID cards ────────────────────────────────────────────────────────────────

enum IdCardStatus {
  QUEUED
  READY
  SENT_TO_PRINT
  PRINTED
  ISSUED
  REVOKED
  REPLACED
  SURRENDERED
  VOID
}

model IdCardTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  orientation   String   @default("PORTRAIT") // PORTRAIT | LANDSCAPE
  widthMm       Float    @default(53.98)
  heightMm      Float    @default(85.6)
  /// [{id,type:TEXT|PHOTO|QR|LOGO|STATIC|SHAPE|SIGNATURE,binding?,text?,xMm,yMm,wMm,hMm,font:{size,weight,color,align,family},fill?,z}]
  front         Json
  back          Json
  frontBgFileId String?
  backBgFileId  String?
  version       Int      @default(1)
  status        String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
}

model IdCard {
  id             String       @id @default(cuid())
  tenantId       String
  employeeId     String
  templateId     String?
  serial         String
  status         IdCardStatus @default(QUEUED)
  missingFields  String[]
  printPdfFileId String?
  dataSnapshot   Json?
  verifyToken    String       @unique
  generatedAt    DateTime?
  printBatchId   String?
  issuedAt       DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, serial])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model IdCardPrintBatch {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  vendorEmail  String
  cardCount    Int
  pdfFileId    String
  status       String   @default("SENT") // QUEUED | SENT | ACKNOWLEDGED | DELIVERED | FAILED
  sentAt       DateTime?
  sentByName   String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ── Visiting cards ──────────────────────────────────────────────────────────

model VCardProfile {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String   @unique
  showPhone   Boolean  @default(true)
  workPhone   String?
  linkedinUrl String?
  publicSlug  String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, publicSlug])
}

model VCardShare {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  channel    String // EMAIL | WHATSAPP
  recipient  String
  status     String
  createdAt  DateTime @default(now())

  @@index([tenantId, employeeId, createdAt])
}
