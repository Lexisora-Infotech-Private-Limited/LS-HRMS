NODE_ENV=development
PORT=4000
# Public origin of the web app (CORS + links in emails)
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://hrms:hrms@localhost:5433/hrms?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Key used to encrypt sensitive columns (salaries, bank details) — 32 bytes base64
DATA_ENCRYPTION_KEY=ZGV2LWRhdGEta2V5LTMyLWJ5dGVzLWxvbmctIS0hLSE=
# Storage: "local" (disk under STORAGE_DIR) or "s3"
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
# Mail (Mailpit in dev: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lexisora HRMS <no-reply@lexisora.hrms.app>"
# Tenancy: requests to <workspace>.<ROOT_DOMAIN> resolve that tenant; in dev the
# login form's Workspace field / X-Tenant header is used.
ROOT_DOMAIN=hrms.app
# Integrations (empty = stub adapter)
GITLAB_URL=
GITLAB_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CCTV_GATEWAY_URL=
ESIGN_PROVIDER=
